{
  "expo": {
    "name": "Blue Collar Alpha",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.strategytracker.odqwcf",
      "infoPlist": {
        "NSCameraUsageDescription": "Capture trade screenshots for AI analysis",
        "NSPhotoLibraryUsageDescription": "Upload trade screenshots for AI analysis",
        "NSMicrophoneUsageDescription": "Record voice notes to journal your trades"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F1F5F8"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.strategytracker.odqwcf",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#F1F5F8"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Record voice notes to journal your trades"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}